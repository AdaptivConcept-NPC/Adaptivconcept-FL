# Adaptivconcept-FL — Environment Variables
# Copy this file to .env.local for local development.

# --------------------------------------------------------------------------
# Invoicing API
# --------------------------------------------------------------------------
# URL of the AI_Codex FastAPI backend (Cloud Run or local).
# The invoicing module reuses the same backend as the Arcade context.
#
# Production example (Cloud Run):
#   VITE_INVOICE_API_URL=https://aicodex-be-1096425756328.us-central1.run.app
#
# Local development:
#   VITE_INVOICE_API_URL=http://localhost:9000
#
# If unset, InvoiceAuthContext falls back to VITE_AICODEX_API_URL.
VITE_INVOICE_API_URL=http://localhost:9000

# --------------------------------------------------------------------------
# Arcade / AICodex backend (existing)
# --------------------------------------------------------------------------
VITE_AICODEX_API_URL=http://localhost:9000
